# Configuração do ChatGraph

# RabbitMQ
RABBIT_USER=seu_usuario
RABBIT_PASS=sua_senha
RABBIT_URI=amqp://localhost
RABBIT_QUEUE=chat_queue
RABBIT_PREFETCH=1
RABBIT_VHOST=/

# gRPC (legado)
GRPC_URI=grpc://localhost:50051

# Só o host; /v1 e /v1/actions continuam aceitos
ROUTER_URL='http://api-voll-hml.verdecard.tech/'
ROUTER_TOKEN='f078b1cf-b4c8-11f0-b4fe-0242ac140002'
# Transporte de entrada: queue (RabbitMQ, padrão) ou stream (WebSocket)
# ROUTER_TRANSPORT=queue
# Menus servidos no stream, separados por vírgula (padrão: RABBIT_QUEUE)
# ROUTER_MENUS=

# ====================================
# Testes de Integração
# ====================================
# Estas variáveis são necessárias APENAS para executar testes de integração
# que fazem chamadas reais para APIs externas.
#
# Se não configuradas, os testes de integração serão automaticamente pulados.

# URL base da API de roteamento (OBRIGATÓRIO para testes de integração)
ROUTER_API_BASE_URL=http://localhost:8000/v1/actions

# Autenticação da API (OPCIONAL - se a API requer autenticação)
ROUTER_API_USERNAME=test_integration_user
ROUTER_API_PASSWORD=f078b1cf-b4c8-11f0-b4fe-0242ac140002

# Timeout para requisições (OPCIONAL - default: 60s)
# ROUTER_API_TIMEOUT=60.0

# IDs para testes (OPCIONAL - valores padrão serão usados)
TEST_USER_ID=6107
TEST_COMPANY_ID=business-tech

# ====================================
# Agentes de IA (extra opcional: pip install chatgraph[agent])
# ====================================
# OpenRouter (provedor de LLM)
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1  # opcional

# Modelo usado pelo Agent (qualquer modelo do OpenRouter)
AGENT_MODEL=openai/gpt-4o-mini
# AGENT_TEMPERATURE=0.7        # opcional (default 0.7)
# AGENT_MAX_TOKENS=2048        # opcional (default 2048)
# AGENT_MAX_TOOL_LOOPS=5       # opcional (default 5)
# AGENT_HISTORY_LIMIT=20       # opcional (default 20)
# AGENT_SYSTEM_PROMPT_FILE=prompts/personalidade.md  # opcional

# Diagnóstico: loga o AgentContext COMPLETO (inclui dados do usuário
# na observation). Use apenas em debug local.
# LOG_AGENT_CONTEXT=1

# Bots com agente: um turno de LLM pode levar vários segundos; com
# RABBIT_PREFETCH=1 o consumer processa 1 mensagem por vez e a fila
# serializa. Considere aumentar (com o caveat de ordenação por chat).
# RABBIT_PREFETCH=4

# Log Publisher (RabbitMQ - opcional)
# Defina LOG_RABBIT_QUEUE para ativar o envio de logs de erro para fila RabbitMQ.
# O exchange e routing key padrão seguem o padrão do Go: exchange = vhost, routing key = chatbot.{queue}
# Com RABBIT_VHOST='/' não existe exchange homônima: cai na exchange
# default do AMQP e a routing key passa a ser o próprio nome da fila.
LOG_RABBIT_QUEUE=logs
LOG_RABBIT_EXCHANGE=chatbot-hml
# LOG_RABBIT_ROUTING_KEY=chatbot.logs  # opcional: default = chatbot.{LOG_RABBIT_QUEUE}
